# --- Providers ------------------------------------------------------------------
# One per port. Defaults: nebius if NEBIUS_API_KEY is set (else openai if
# OPENAI_API_KEY, else offline); nim if NIM_*_URL is set, else the browser.
# The hackathon requires at least one NVIDIA model: keep nebius and/or nim for the submission.
# nebius | openai | offline
LLM_PROVIDER=
# nim | openai | browser
STT_PROVIDER=
# nim | openai | browser
TTS_PROVIDER=

# --- NVIDIA Nemotron on Nebius Token Factory (brain) -------------------------
# Create a key at https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMO_FAST_MODEL=nvidia/Nemotron-3_5-Lightning
NEMO_SMART_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Tavily real-time web search -----------------------------------------------
# https://app.tavily.com
TAVILY_API_KEY=

# --- NVIDIA speech NIMs on a Nebius AI Cloud GPU VM (see infra/README.md) --------
# Leave empty to fall back to the browser's speech recognition / synthesis.
NIM_ASR_URL=
NIM_TTS_URL=
NIM_TTS_VOICE=Magpie-Multilingual.EN-US.Aria

# --- OpenAI (alternative for every port) ---------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Chat Completions only allows tool calls on these models with reasoning off ("none").
OPENAI_FAST_MODEL=gpt-6-luna
OPENAI_SMART_MODEL=gpt-6-luna
OPENAI_FAST_REASONING=none
OPENAI_SMART_REASONING=none
# Realtime transcription (PCM 24 kHz, Nemo upsamples the 16 kHz mic and commits on pauses)
OPENAI_STT_MODEL=gpt-live-transcribe
OPENAI_STT_LANGUAGE=en
# far_field suits one mic for the whole room; near_field for a headset
OPENAI_STT_NOISE=far_field
# Text-to-speech (raw PCM 24 kHz)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_INSTRUCTIONS=Warm, upbeat brainstorming facilitator. Short, friendly, natural pace.

# --- Behaviour -------------------------------------------------------------------
PORT=8787
# brainmaster (default): directive, fast, starts methods itself and challenges ideas
# calm: discreet facilitator that proposes and asks before acting
NEMO_STYLE=brainmaster
# quiet | balanced | active (calm style only)
NEMO_PROACTIVITY=balanced
# < 1 compresses every phase timebox (useful for short demos)
NEMO_TIMEBOX_SCALE=1
NEMO_COACH_INTERVAL_MS=25000
# Silent start: Nemo intervenes on its own only after this delay (it still captures ideas and answers when asked)
NEMO_WARMUP_MS=180000
# Silence before Nemo relaunches the room
NEMO_RELAUNCH_SILENCE_MS=5000
# Set to 1 to force offline adapters even if keys are present
NEMO_OFFLINE=
